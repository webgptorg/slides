{
    "name": "promptbook-slides",
    "scripts": {
        "convert:presentations": "node ./scripts/convert-presentations.mjs",
        "coder:generate-boilerplates": "npx ptbk coder generate-boilerplates --template ./prompts/templates/common.md",
        "coder:run": "npx ptbk coder run --agent github-copilot --model gpt-5.4 --thinking-level xhigh --context AGENTS.md --no-wait",
        "coder:find-refactor-candidates": "npx ptbk coder find-refactor-candidates",
        "coder:verify": "npx ptbk coder verify"
    },
    "devDependencies": {
        "@marp-team/marp-cli": "4.1.2",
        "@types/node": "22.13.10",
        "colors": "1.4.0",
        "spacetrim": "0.11.60"
    },
    "funding": [
        {
            "type": "individual",
            "url": "https://buymeacoffee.com/hejny"
        },
        {
            "type": "github",
            "url": "https://github.com/webgptorg/slides/blob/main/README.md#%EF%B8%8F-contributing"
        }
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/webgptorg/slides"
    },
    "dependencies": {
        "ptbk": "^0.112.0-70"
    }
}
